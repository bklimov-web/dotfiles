// Place your key bindings in this file to override the defaults
[
  // FILE TREE
  {
    "command": "workbench.action.focusFirstEditorGroup",
    "key": "ctrl+l",
    "when": "!editorTextFocus"
  },
  {
    "command": "workbench.files.action.focusFilesExplorer",
    "key": "ctrl+h",
    "when": "editorTextFocus"
  },
  // FILE OPERATIONS
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "command": "renameFile",
    "key": "r",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "command": "deleteFile",
    "key": "d",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "command": "filesExplorer.copy",
    "key": "c",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "command": "filesExplorer.paste",
    "key": "p",
    "when": "filesExplorerFocus && !inputFocus"
  },
  // EXTENSIONS
  {
    // console.log переменной под курсором на следующей строке.
    // Если строка заканчивается на [ { или ( — лог ставится после парной ] } или ).
    // Слово идёт через именной регистр "a: без выделения и без системного буфера.
    "key": "cmd+i",
    "command": "vim.remap",
    "when": "editorTextFocus && vim.mode == 'Normal'",
    "args": {
      "after": ["\"", "a", "y", "i", "w", "$", "%", "o", "c", "o", "n", "s", "o", "l", "e", ".", "l", "o", "g", "(", "'", "<C-r>", "a", ":", "'", ",", "<space>", "<C-r>", "a", ")", ";", "<Esc>"]
    }
  },
  // CODE NAVIGATION
  {
    "key": "ctrl+h",
    "command": "workbench.files.action.focusFilesExplorer",
    "when": "editorTextFocus && activeEditorGroupIndex == 1 && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusLeftGroup",
    "when": "editorTextFocus && activeEditorGroupIndex != 1 && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusRightGroup",
    "when": "editorTextFocus && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusAboveGroup",
    "when": "editorTextFocus && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.terminal.focus",
    "when": "editorTextFocus && vim.mode == 'Normal'"
  },
  // TERMINAL NAVIGATION
  {
    "key": "ctrl+w",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.terminal.focusPreviousPane",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.terminal.focusNextPane",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus"
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b\r"
    },
    "when": "terminalFocus"
  }
]